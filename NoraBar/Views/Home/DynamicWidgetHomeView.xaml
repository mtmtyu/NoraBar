<UserControl x:Class="NoraBar.Views.Home.DynamicWidgetHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NoraBar.Views.Home"
             AllowDrop="True"
             DragOver="DynamicWidgetHomeView_DragOver"
             Drop="DynamicWidgetHomeView_Drop">
    <Grid>
        <Border x:Name="RootIslandBorder"
                Style="{DynamicResource IslandBorderStyle}"
                Padding="12,8">
            <ScrollViewer x:Name="WidgetsScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <local:HomeWidgetPanel x:Name="WidgetsContainer"
                                       VerticalAlignment="Center"/>
            </ScrollViewer>
        </Border>

        <Border x:Name="EditOutlineBorder"
                Visibility="Collapsed"
                BorderBrush="#C064B5F6"
                BorderThickness="2"
                CornerRadius="22"
                Background="Transparent"
                IsHitTestVisible="False"/>
    </Grid>
</UserControl>
