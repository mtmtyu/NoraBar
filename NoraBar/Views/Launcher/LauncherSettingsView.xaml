<UserControl x:Class="NoraBar.Views.Launcher.LauncherSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="Root_Drop" DragOver="Root_DragOver">
    <Grid>
        <TabControl Background="Transparent" BorderThickness="0" Foreground="White">
            <TabItem Header="{Binding Strings.PagesItems}">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="{Binding Strings.Pages}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="＋" ToolTip="{Binding Strings.AddPage}" Click="AddPage_Click" Width="30" Height="28"/>
                            <Button Content="−" ToolTip="{Binding Strings.RemovePage}" Click="RemovePage_Click" Width="30" Height="28" Margin="4,0,0,0"/>
                            <Button Content="↑" ToolTip="{Binding Strings.MovePageUp}" Click="MovePageUp_Click" Width="30" Height="28" Margin="4,0,0,0"/>
                            <Button Content="↓" ToolTip="{Binding Strings.MovePageDown}" Click="MovePageDown_Click" Width="30" Height="28" Margin="4,0,0,0"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" DisplayMemberPath="DisplayName" Height="28"/>
                    </DockPanel>

                    <TextBox Text="{Binding SelectedPage.DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                             ToolTip="{Binding Strings.PageName}" AutomationProperties.Name="{Binding Strings.PageName}"/>

                    <TextBlock Text="{Binding Strings.Groups}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="＋" ToolTip="{Binding Strings.AddGroup}" Click="AddGroup_Click" Width="30" Height="28"/>
                            <Button Content="−" ToolTip="{Binding Strings.RemoveGroup}" Click="RemoveGroup_Click" Width="30" Height="28" Margin="4,0,0,0"/>
                            <Button Content="↑" ToolTip="{Binding Strings.MoveGroupUp}" Click="MoveGroupUp_Click" Width="30" Height="28" Margin="4,0,0,0"/>
                            <Button Content="↓" ToolTip="{Binding Strings.MoveGroupDown}" Click="MoveGroupDown_Click" Width="30" Height="28" Margin="4,0,0,0"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding SelectedPage.Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="DisplayName" Height="28"/>
                    </DockPanel>
                    <TextBox Text="{Binding SelectedGroup.DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                             ToolTip="{Binding Strings.GroupName}" AutomationProperties.Name="{Binding Strings.GroupName}"/>

                    <TextBlock Text="{Binding Strings.ItemsDropHint}" Foreground="#AFFFFFFF" Margin="0,0,0,5"/>
                    <ListBox ItemsSource="{Binding SelectedGroup.Items}" SelectedItem="{Binding SelectedItem}" Height="135"
                             DisplayMemberPath="DisplayName" ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    <WrapPanel Margin="0,6,0,10">
                        <Button Content="{Binding Strings.InstalledApps}" Click="AddInstalled_Click" Padding="8,4" Margin="0,0,4,4"/>
                        <Button Content="{Binding Strings.RunningApps}" Click="AddRunning_Click" Padding="8,4" Margin="0,0,4,4"/>
                        <Button Content="{Binding Strings.File}" Click="AddFile_Click" Padding="8,4" Margin="0,0,4,4"/>
                        <Button Content="{Binding Strings.Folder}" Click="AddFolder_Click" Padding="8,4" Margin="0,0,4,4"/>
                        <Button Content="{Binding Strings.Url}" Click="AddUrl_Click" Padding="8,4" Margin="0,0,4,4"/>
                        <Button Content="{Binding Strings.Remove}" Click="RemoveItem_Click" Padding="8,4" Margin="0,0,4,4"/>
                        <Button Content="↑" ToolTip="{Binding Strings.MoveItemUp}" Click="MoveItemUp_Click" Width="30" Margin="0,0,4,4"/>
                        <Button Content="↓" ToolTip="{Binding Strings.MoveItemDown}" Click="MoveItemDown_Click" Width="30" Margin="0,0,4,4"/>
                    </WrapPanel>

                    <Expander Header="{Binding Strings.ItemEditor}" IsExpanded="True">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Strings.Name}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding SelectedItem.DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Text="{Binding Strings.ItemType}" VerticalAlignment="Center"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ItemKinds}" SelectedItem="{Binding SelectedItem.Kind}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Text="{Binding Strings.ExistingInstanceBehavior}" VerticalAlignment="Center"/><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ExistingInstanceBehaviors}" SelectedItem="{Binding SelectedItem.ExistingInstanceBehavior}" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Text="{Binding Strings.Target}" VerticalAlignment="Center"/><DockPanel Grid.Row="3" Grid.Column="1"><Button DockPanel.Dock="Right" Content="{Binding Strings.Locate}" Click="LocateTarget_Click" Margin="4,2,0,2"/><TextBox Text="{Binding SelectedItem.Target, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/></DockPanel>
                            <TextBlock Grid.Row="4" Text="{Binding Strings.Arguments}" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedItem.Arguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Text="{Binding Strings.WorkingDirectory}" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedItem.WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                            <TextBlock Grid.Row="6" Text="{Binding Strings.CustomIcon}" VerticalAlignment="Center"/><DockPanel Grid.Row="6" Grid.Column="1"><Button Content="{Binding Strings.Browse}" DockPanel.Dock="Right" Click="BrowseIcon_Click"/><TextBox Text="{Binding SelectedItem.CustomIconPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,4,2"/></DockPanel>
                            <TextBlock Grid.Row="7" Text="{Binding Strings.SpecificBrowser}" VerticalAlignment="Center"/><TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SelectedItem.BrowserTarget, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                            <CheckBox Grid.Row="8" Grid.Column="1" Content="{Binding Strings.RunAsAdministrator}" IsChecked="{Binding SelectedItem.RunAsAdministrator}" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Strings.TargetNotFound}" Foreground="#FFFF8A80" Margin="0,5,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.IsMissing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Expander>
                </StackPanel>
            </TabItem>

            <TabItem Header="{Binding Strings.Smart}">
                <StackPanel Margin="0,16,0,0">
                    <CheckBox Content="{Binding Strings.EnableSmart}" IsChecked="{Binding SmartEnabled}"/>
                    <TextBlock Text="{Binding Strings.SmartPrivacy}"
                               TextWrapping="Wrap" Foreground="#AFFFFFFF" Margin="0,8,0,16"/>
                    <Button Content="{Binding Strings.ClearUsage}" Click="ClearUsage_Click" HorizontalAlignment="Left" Padding="10,5"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="{Binding Strings.Rules}">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="{Binding Strings.RulesDescription}"
                               TextWrapping="Wrap" Foreground="#AFFFFFFF" Margin="0,0,0,10"/>
                    <ListBox ItemsSource="{Binding Rules}" x:Name="RulesList" Height="220">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TargetPageId}" FontWeight="SemiBold"/>
                                        <TextBlock Foreground="#AFFFFFFF"><Run Text="{Binding DataContext.Strings.Priority, RelativeSource={RelativeSource AncestorType=UserControl}}"/><Run Text="{Binding Priority}"/></TextBlock>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" IsHitTestVisible="False"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{Binding Strings.Add}" Click="AddRule_Click" Padding="10,5"/>
                        <Button Content="{Binding Strings.Edit}" Click="EditRule_Click" Padding="10,5" Margin="5,0,0,0"/>
                        <Button Content="{Binding Strings.Delete}" Click="DeleteRule_Click" Padding="10,5" Margin="5,0,0,0"/>
                        <Button Content="↑" Click="MoveRuleUp_Click" ToolTip="{Binding Strings.MoveRuleUp}" AutomationProperties.Name="{Binding Strings.MoveRuleUp}" Width="30" Margin="5,0,0,0"/>
                        <Button Content="↓" Click="MoveRuleDown_Click" ToolTip="{Binding Strings.MoveRuleDown}" AutomationProperties.Name="{Binding Strings.MoveRuleDown}" Width="30" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="{Binding Strings.Shortcuts}">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="{Binding Strings.OpenLauncher}" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding OpenShortcutText, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" ToolTip="{Binding Strings.ShortcutHint}"/>
                    <TextBlock Text="{Binding Strings.OpenSearch}" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding SearchShortcutText, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" ToolTip="{Binding Strings.SearchShortcutHint}"/>
                    <TextBlock Text="{Binding ShortcutError}" Foreground="#FFFF8A80" TextWrapping="Wrap"/>
                    <Button Content="{Binding Strings.ApplyShortcuts}" Click="ApplyShortcuts_Click" HorizontalAlignment="Left" Padding="10,5" Margin="0,10,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
