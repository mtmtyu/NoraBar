<UserControl x:Class="NoraBar.Views.Launcher.LauncherSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="Root_Drop" DragOver="Root_DragOver">
    <UserControl.Resources>
        <!-- Accent Brush Fallback -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />

        <!-- Setting Card Border Style -->
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderBrush" Value="#10FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Typography styles -->
        <Style x:Key="CardHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Yu Gothic UI, Meiryo" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F5F5F5" />
        </Style>

        <Style x:Key="CardSubHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Yu Gothic UI, Meiryo" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8A8A8A" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- Square Action Button Style -->
        <Style x:Key="SettingSquareButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Action Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI, Yu Gothic UI, Meiryo"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Brd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Primary Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#005A9E"/>
                                <Setter TargetName="Brd" Property="BorderBrush" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#004578"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch Style for CheckBoxes -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="TemplateRoot" Background="Transparent" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SwitchArea" Grid.Column="0" Width="44" Height="20" Background="#33FFFFFF" CornerRadius="10" BorderBrush="#20FFFFFF" BorderThickness="1">
                                <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="#E3E3E3" HorizontalAlignment="Left" Margin="3,0,3,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchArea" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="SwitchArea" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="24" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CircleEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CircleEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontFamily" Value="Segoe UI, Yu Gothic UI, Meiryo"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                x:Name="Brd">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xE70D;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           Foreground="#88FFFFFF"
                                                           FontSize="8"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Brd" Property="Background" Value="#25FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,3,26,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#1F1F1F"
                                            BorderBrush="#30FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="0,2,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.4" Color="Black"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel x:Name="ItemsPresenter" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontFamily" Value="Segoe UI, Yu Gothic UI, Meiryo"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3" Margin="2,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontFamily" Value="Segoe UI, Yu Gothic UI, Meiryo"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Brd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#25FFFFFF"/>
                                <Setter TargetName="Brd" Property="BorderBrush" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#25FFFFFF"/>
                                <Setter TargetName="Brd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Brd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ListBox & ListBoxItem Styles -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Expander Style -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#08FFFFFF"/>
            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <DockPanel>
                                <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderBrd" Background="#10FFFFFF" CornerRadius="5" Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="Arrow" Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#8AFFFFFF" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderBrd" Property="Background" Value="#1AFFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Text" Value="&#xE70E;"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ToggleButton.Content>
                                        <ContentPresenter ContentSource="Header"/>
                                    </ToggleButton.Content>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom" Focusable="False" Visibility="Collapsed" Margin="12,8,12,12"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TabControl Header Style -->
        <Style x:Key="ModernTabItemStyle" TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12" FontFamily="Segoe UI, Yu Gothic UI, Meiryo"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Brd" Background="Transparent" CornerRadius="6" Padding="14,7" Margin="0,0,4,0" Cursor="Hand">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#15FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#8AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Tab Header Bar -->
                            <Border Background="#0AFFFFFF" CornerRadius="8" Padding="4" Margin="0,0,0,14" BorderBrush="#10FFFFFF" BorderThickness="1">
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1" Panel.ZIndex="1"/>
                            </Border>
                            <!-- Tab Content Area -->
                            <Grid x:Name="ContentPanel" Grid.Row="1" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <TabControl Style="{StaticResource ModernTabControlStyle}" Foreground="White">
            <!-- Tab 1: Pages & Items -->
            <TabItem Header="{Binding Strings.PagesItems}" Style="{StaticResource ModernTabItemStyle}">
                <StackPanel Margin="0,4,0,0">

                    <!-- Card 1: Page Management -->
                    <Border Style="{StaticResource SettingCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding Strings.Pages}" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,8"/>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="＋" ToolTip="{Binding Strings.AddPage}" Click="AddPage_Click" Style="{StaticResource SettingSquareButtonStyle}"/>
                                    <Button Content="−" ToolTip="{Binding Strings.RemovePage}" Click="RemovePage_Click" Style="{StaticResource SettingSquareButtonStyle}" Margin="4,0,0,0"/>
                                    <Button Content="↑" ToolTip="{Binding Strings.MovePageUp}" Click="MovePageUp_Click" Style="{StaticResource SettingSquareButtonStyle}" Margin="4,0,0,0"/>
                                    <Button Content="↓" ToolTip="{Binding Strings.MovePageDown}" Click="MovePageDown_Click" Style="{StaticResource SettingSquareButtonStyle}" Margin="4,0,0,0"/>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" DisplayMemberPath="DisplayName" Height="28"/>
                            </DockPanel>
                            <TextBox Text="{Binding SelectedPage.DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding Strings.PageName}" AutomationProperties.Name="{Binding Strings.PageName}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Group Management -->
                    <Border Style="{StaticResource SettingCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding Strings.Groups}" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,8"/>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="＋" ToolTip="{Binding Strings.AddGroup}" Click="AddGroup_Click" Style="{StaticResource SettingSquareButtonStyle}"/>
                                    <Button Content="−" ToolTip="{Binding Strings.RemoveGroup}" Click="RemoveGroup_Click" Style="{StaticResource SettingSquareButtonStyle}" Margin="4,0,0,0"/>
                                    <Button Content="↑" ToolTip="{Binding Strings.MoveGroupUp}" Click="MoveGroupUp_Click" Style="{StaticResource SettingSquareButtonStyle}" Margin="4,0,0,0"/>
                                    <Button Content="↓" ToolTip="{Binding Strings.MoveGroupDown}" Click="MoveGroupDown_Click" Style="{StaticResource SettingSquareButtonStyle}" Margin="4,0,0,0"/>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding SelectedPage.Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="DisplayName" Height="28"/>
                            </DockPanel>
                            <TextBox Text="{Binding SelectedGroup.DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding Strings.GroupName}" AutomationProperties.Name="{Binding Strings.GroupName}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Items List -->
                    <Border Style="{StaticResource SettingCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding Strings.ItemsDropHint}" Style="{StaticResource CardSubHeaderStyle}" Margin="0,0,0,8"/>
                            <ListBox ItemsSource="{Binding SelectedGroup.Items}" SelectedItem="{Binding SelectedItem}" Height="125" Margin="0,0,0,10"
                                     DisplayMemberPath="DisplayName" ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                            <WrapPanel Margin="0,0,0,0">
                                <Button Content="{Binding Strings.InstalledApps}" Click="AddInstalled_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,4,4"/>
                                <Button Content="{Binding Strings.RunningApps}" Click="AddRunning_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,4,4"/>
                                <Button Content="{Binding Strings.File}" Click="AddFile_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,4,4"/>
                                <Button Content="{Binding Strings.Folder}" Click="AddFolder_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,4,4"/>
                                <Button Content="{Binding Strings.Url}" Click="AddUrl_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,4,4"/>
                                <Button Content="{Binding Strings.Remove}" Click="RemoveItem_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,4,4"/>
                                <Button Content="↑" ToolTip="{Binding Strings.MoveItemUp}" Click="MoveItemUp_Click" Style="{StaticResource SettingSquareButtonStyle}" Margin="0,0,4,4"/>
                                <Button Content="↓" ToolTip="{Binding Strings.MoveItemDown}" Click="MoveItemDown_Click" Style="{StaticResource SettingSquareButtonStyle}" Margin="0,0,4,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Item Details Editor -->
                    <Expander Header="{Binding Strings.ItemEditor}" IsExpanded="True">
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Strings.Name}" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding SelectedItem.DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>

                            <TextBlock Grid.Row="1" Text="{Binding Strings.ItemType}" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="12"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ItemKinds}" SelectedItem="{Binding SelectedItem.Kind}" Margin="0,3"/>

                            <TextBlock Grid.Row="2" Text="{Binding Strings.ExistingInstanceBehavior}" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="12"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ExistingInstanceBehaviors}" SelectedItem="{Binding SelectedItem.ExistingInstanceBehavior}" Margin="0,3"/>

                            <TextBlock Grid.Row="3" Text="{Binding Strings.Target}" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="12"/>
                            <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,3">
                                <Button DockPanel.Dock="Right" Content="{Binding Strings.Locate}" Click="LocateTarget_Click" Style="{StaticResource ModernButtonStyle}" Padding="8,2" Margin="4,0,0,0"/>
                                <TextBox Text="{Binding SelectedItem.Target, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="4" Text="{Binding Strings.Arguments}" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="12"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedItem.Arguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>

                            <TextBlock Grid.Row="5" Text="{Binding Strings.WorkingDirectory}" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="12"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedItem.WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>

                            <TextBlock Grid.Row="6" Text="{Binding Strings.CustomIcon}" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="12"/>
                            <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,3">
                                <Button Content="{Binding Strings.Browse}" DockPanel.Dock="Right" Click="BrowseIcon_Click" Style="{StaticResource ModernButtonStyle}" Padding="8,2" Margin="4,0,0,0"/>
                                <TextBox Text="{Binding SelectedItem.CustomIconPath, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="7" Text="{Binding Strings.SpecificBrowser}" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="12"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SelectedItem.BrowserTarget, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>

                            <CheckBox Grid.Row="8" Grid.Column="1" Content="{Binding Strings.RunAsAdministrator}" IsChecked="{Binding SelectedItem.RunAsAdministrator}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,8,0,4"/>

                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Strings.TargetNotFound}" Foreground="#FFFF8A80" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.IsMissing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Expander>
                </StackPanel>
            </TabItem>

            <!-- Tab 2: Smart Launcher -->
            <TabItem Header="{Binding Strings.Smart}" Style="{StaticResource ModernTabItemStyle}">
                <StackPanel Margin="0,4,0,0">
                    <Border Style="{StaticResource SettingCardStyle}">
                        <StackPanel>
                            <CheckBox Content="{Binding Strings.EnableSmart}" IsChecked="{Binding SmartEnabled}" Style="{StaticResource ToggleSwitchStyle}"/>
                            <TextBlock Text="{Binding Strings.SmartPrivacy}" Style="{StaticResource CardSubHeaderStyle}" Margin="0,10,0,16"/>
                            <Button Content="{Binding Strings.ClearUsage}" Click="ClearUsage_Click" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Left" Padding="14,6"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- Tab 3: Automatic Rules -->
            <TabItem Header="{Binding Strings.Rules}" Style="{StaticResource ModernTabItemStyle}">
                <StackPanel Margin="0,4,0,0">
                    <Border Style="{StaticResource SettingCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding Strings.RulesDescription}" Style="{StaticResource CardSubHeaderStyle}" Margin="0,0,0,12"/>
                            <ListBox ItemsSource="{Binding Rules}" x:Name="RulesList" Height="210" Margin="0,0,0,12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TargetPageId}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                                <TextBlock Foreground="#8AFFFFFF" FontSize="11" Margin="0,2,0,0"><Run Text="{Binding DataContext.Strings.Priority, RelativeSource={RelativeSource AncestorType=UserControl}}"/><Run Text=" "/><Run Text="{Binding Priority}"/></TextBlock>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" IsHitTestVisible="False" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel>
                                <Button Content="{Binding Strings.Add}" Click="AddRule_Click" Style="{StaticResource AccentButtonStyle}" Padding="14,6" Margin="0,0,6,4"/>
                                <Button Content="{Binding Strings.Edit}" Click="EditRule_Click" Style="{StaticResource ModernButtonStyle}" Padding="14,6" Margin="0,0,6,4"/>
                                <Button Content="{Binding Strings.Delete}" Click="DeleteRule_Click" Style="{StaticResource ModernButtonStyle}" Padding="14,6" Margin="0,0,6,4"/>
                                <Button Content="↑" Click="MoveRuleUp_Click" ToolTip="{Binding Strings.MoveRuleUp}" AutomationProperties.Name="{Binding Strings.MoveRuleUp}" Style="{StaticResource SettingSquareButtonStyle}" Margin="0,0,6,4"/>
                                <Button Content="↓" Click="MoveRuleDown_Click" ToolTip="{Binding Strings.MoveRuleDown}" AutomationProperties.Name="{Binding Strings.MoveRuleDown}" Style="{StaticResource SettingSquareButtonStyle}" Margin="0,0,6,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- Tab 4: Shortcuts -->
            <TabItem Header="{Binding Strings.Shortcuts}" Style="{StaticResource ModernTabItemStyle}">
                <StackPanel Margin="0,4,0,0">
                    <Border Style="{StaticResource SettingCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding Strings.OpenLauncher}" Style="{StaticResource CardHeaderStyle}"/>
                            <TextBox Text="{Binding OpenShortcutText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,16" ToolTip="{Binding Strings.ShortcutHint}"/>

                            <TextBlock Text="{Binding Strings.OpenSearch}" Style="{StaticResource CardHeaderStyle}"/>
                            <TextBox Text="{Binding SearchShortcutText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14" ToolTip="{Binding Strings.SearchShortcutHint}"/>

                            <TextBlock Text="{Binding ShortcutError}" Foreground="#FFFF8A80" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <Button Content="{Binding Strings.ApplyShortcuts}" Click="ApplyShortcuts_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Padding="16,7"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
