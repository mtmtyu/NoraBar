<Window x:Class="NoraBar.Views.Launcher.LauncherEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:launcher="clr-namespace:NoraBar.Hud.Launcher"
        mc:Ignorable="d"
        Title="{Binding Strings.VisualLauncherEditorTitle}"
        Height="640" Width="960"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="CardBackground" Color="#16FFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#25FFFFFF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F5" />
        <SolidColorBrush x:Key="TextSecondary" Color="#A0A0A0" />

        <!-- TitleBar Button Style -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Square Action Button Style -->
        <Style x:Key="SquareButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Action Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Brd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#005A9E"/>
                                <Setter TargetName="Brd" Property="BorderBrush" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#004578"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch Style for CheckBoxes -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="TemplateRoot" Background="Transparent" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SwitchArea" Grid.Column="0" Width="40" Height="18" Background="#33FFFFFF" CornerRadius="9" BorderBrush="#20FFFFFF" BorderThickness="1">
                                <Ellipse x:Name="Thumb" Width="10" Height="10" Fill="#E3E3E3" HorizontalAlignment="Left" Margin="3,0,3,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchArea" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="SwitchArea" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="22" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CircleEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CircleEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Dark TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Dark ListBox Style -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="#1E1E22" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Page Navigation Bar -->
                <RowDefinition Height="*"/> <!-- Main Content (Canvas + Inspector) -->
            </Grid.RowDefinitions>

            <!-- Row 0: Custom Title Bar -->
            <Border Grid.Row="0" Background="#0DFFFFFF" CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Image Source="/Assets/AppIcon.ico" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Strings.VisualLauncherEditorTitle}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding Strings.ItemsDropHint}" Foreground="{StaticResource TextSecondary}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Button Grid.Column="2" Content="✕" Click="Close_Click" Style="{StaticResource TitleBarButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Row 1: Page Navigation Bar -->
            <Border Grid.Row="1" Background="#08FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,1" Padding="12,8">
                <DockPanel>
                    <!-- Actions Right -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Strings.PageName}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding SelectedPage.DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,10,0"/>
                        <Button Content="{Binding Strings.AddPageAction}" Click="AddPage_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,4,0"/>
                        <Button Content="−" ToolTip="{Binding Strings.RemovePage}" Click="RemovePage_Click" Style="{StaticResource SquareButtonStyle}" Margin="0,0,4,0"/>
                        <Button Content="↑" ToolTip="{Binding Strings.MovePageUp}" Click="MovePageUp_Click" Style="{StaticResource SquareButtonStyle}" Margin="0,0,4,0"/>
                        <Button Content="↓" ToolTip="{Binding Strings.MovePageDown}" Click="MovePageDown_Click" Style="{StaticResource SquareButtonStyle}"/>
                    </StackPanel>

                    <!-- Page Tabs Left -->
                    <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" VerticalAlignment="Center" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Medium" Margin="4,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Row 2: Main Workspace (Canvas + Inspector) -->
            <Grid Grid.Row="2" Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/> <!-- Visual Canvas -->
                    <ColumnDefinition Width="10"/> <!-- Splitter Spacing -->
                    <ColumnDefinition Width="310"/> <!-- Inspector Panel -->
                </Grid.ColumnDefinitions>

                <!-- Column 0: Visual Canvas -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Action Toolbar -->
                        <RowDefinition Height="*"/> <!-- Groups & Items Container -->
                    </Grid.RowDefinitions>

                    <!-- Action Toolbar -->
                    <Border Grid.Row="0" Background="#0AFFFFFF" CornerRadius="6" Padding="8,6" Margin="0,0,0,10" BorderBrush="#15FFFFFF" BorderThickness="1">
                        <WrapPanel VerticalAlignment="Center">
                            <Button Content="{Binding Strings.InstalledApps}" Click="AddInstalled_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="{Binding Strings.RunningApps}" Click="AddRunning_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="{Binding Strings.File}" Click="AddFile_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="{Binding Strings.Folder}" Click="AddFolder_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="{Binding Strings.Url}" Click="AddUrl_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="{Binding Strings.AddGroup}" Click="AddGroup_Click" Style="{StaticResource ModernButtonStyle}"/>
                        </WrapPanel>
                    </Border>

                    <!-- Groups Visual Container -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" AllowDrop="True" Drop="Canvas_Drop" DragOver="Canvas_DragOver">
                        <ItemsControl ItemsSource="{Binding SelectedPage.Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <!-- Group Header Bar -->
                                            <DockPanel Margin="0,0,0,8">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="↑" Click="MoveGroupUp_Click" Tag="{Binding}" Style="{StaticResource SquareButtonStyle}" Margin="0,0,4,0"/>
                                                    <Button Content="↓" Click="MoveGroupDown_Click" Tag="{Binding}" Style="{StaticResource SquareButtonStyle}" Margin="0,0,4,0"/>
                                                    <Button Content="−" Click="RemoveGroup_Click" Tag="{Binding}" Style="{StaticResource SquareButtonStyle}"/>
                                                </StackPanel>
                                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            </DockPanel>

                                            <!-- Group Items Grid -->
                                            <ListBox ItemsSource="{Binding Items}"
                                                     SelectedItem="{Binding DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     BorderThickness="0" Background="Transparent" Margin="0,4,0,0">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Width="Auto"/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="85" Height="80" Background="#18FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="6" Padding="4" Margin="4">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Grid.Row="0" Text="{Binding DataContext.Strings.DefaultItemIcon, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Row="1" Text="{Binding DisplayName}" FontSize="10" Foreground="White" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Column 2: Right Property Inspector -->
                <Border Grid.Column="2" Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Inspector Header -->
                        <TextBlock Grid.Row="0" Text="{Binding Strings.ItemEditor}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                        <!-- Inspector Body -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Item Selected Inspector -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="{Binding Strings.Name}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SelectedItem.DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Text="{Binding Strings.ItemType}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding ItemKinds}" SelectedItem="{Binding SelectedItem.Kind}" Margin="0,0,0,8"/>

                                    <TextBlock Text="{Binding Strings.Target}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button Content="{Binding Strings.Locate}" Click="LocateTarget_Click" DockPanel.Dock="Right" Style="{StaticResource ModernButtonStyle}" Margin="4,0,0,0"/>
                                        <TextBox Text="{Binding SelectedItem.Target, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>

                                    <TextBlock Text="{Binding Strings.Arguments}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SelectedItem.Arguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Text="{Binding Strings.WorkingDirectory}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SelectedItem.WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Text="{Binding Strings.CustomIcon}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button Content="{Binding Strings.Browse}" Click="BrowseIcon_Click" DockPanel.Dock="Right" Style="{StaticResource ModernButtonStyle}" Margin="4,0,0,0"/>
                                        <TextBox Text="{Binding SelectedItem.CustomIconPath, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>

                                    <TextBlock Text="{Binding Strings.SpecificBrowser}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SelectedItem.BrowserTarget, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                    <TextBlock Text="{Binding Strings.ExistingInstanceBehavior}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding ExistingInstanceBehaviors}" SelectedItem="{Binding SelectedItem.ExistingInstanceBehavior}" Margin="0,0,0,8"/>

                                    <CheckBox Content="{Binding Strings.RunAsAdministrator}" IsChecked="{Binding SelectedItem.RunAsAdministrator}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4,0,12"/>

                                    <Button Content="{Binding Strings.Remove}" Click="RemoveItem_Click" Style="{StaticResource ModernButtonStyle}" Foreground="#FF6B6B" BorderBrush="#55FF6B6B" Margin="0,0,0,8"/>

                                    <TextBlock Text="{Binding Strings.TargetNotFound}" Foreground="#FFFF8A80" FontSize="11" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedItem.IsMissing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- No Selection Hint -->
                                <TextBlock Text="{Binding Strings.InspectorNoSelectionHint}"
                                           Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
